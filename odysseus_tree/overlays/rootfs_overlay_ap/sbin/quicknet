#!/bin/sh

do_start() {
    # lo
    ip addr add 127.0.0.1/8 dev lo
    ip link set dev lo up

    # eth0 main
    ip link set dev eth0 up

    # wlan0 (hostapd will manage the radio)
    ip link set dev wlan0 up

    # Enable IP forwarding so we route between eth0 and wlan0
    sysctl -w net.ipv4.ip_forward=1
    sysctl -w net.ipv4.conf.all.rp_filter=2
    sysctl -w net.ipv4.conf.eth0.rp_filter=2
    sysctl -w net.ipv4.conf.wlan0.rp_filter=2

    # Allow forwarding both directions (only if iptables filter is enforced)
    iptables -A FORWARD -i eth0 -o wlan0 -j ACCEPT 2>/dev/null
    iptables -A FORWARD -i wlan0 -o eth0 -j ACCEPT 2>/dev/null

    # IPv6 still off on the HaLow side — keep that
    sysctl -w net.ipv6.conf.wlan0.disable_ipv6=1

}

do_stop() {
    iptables -D FORWARD -i eth0 -o wlan0 -j ACCEPT 2>/dev/null
    iptables -D FORWARD -i wlan0 -o eth0 -j ACCEPT 2>/dev/null

    ip link set dev wlan0 down
    ip link set dev eth0 down
    ip link set dev lo down
}

if [ "$1" = init ]; then
    do_start
elif [ "$1" = deinit ]; then
    do_stop
else
    echo "Usage: {init|deinit}"
fi
