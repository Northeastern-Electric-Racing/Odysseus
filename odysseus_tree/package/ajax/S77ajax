#!/bin/sh

PIDFILE=/var/run/ajax.pid
EXECUTABLE=/usr/bin/ajax
INTERFACE_NAME=can0
PORT=8083

case "$1" in
  start)
    echo "Starting ajax..."
    # start (S) executable (x) in background (b), make pid file (m) at p
    start-stop-daemon -S -x "$EXECUTABLE" -b -m -p "$PIDFILE" -- --interface $INTERFACE_NAME serve --port $PORT
    ;;
  stop)
    echo "Stopping ajax..."
    # stop (K) and remove pidfile
    start-stop-daemon -K -p "$PIDFILE"
    rm "$PIDFILE"
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: {start|stop|restart/reload}"
    exit 1
esac
