#!/bin/sh

PIDFILE=/var/run/wheel_buttons.pid
EXECUTABLE=/usr/bin/wheel_buttons

case "$1" in
  start)
    echo "Starting wheel buttons..."
    # start (S) executable (x) in background (b), make pid file (m) at p
    start-stop-daemon -S -x "$EXECUTABLE" -b -m -p "$PIDFILE"
    ;;
  stop)
    echo "Stopping wheel buttons..."
    # stop (K) and remove pidfile
    start-stop-daemon -K -p "$PIDFILE"
    rm "$PIDFILE"
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: {start|stop|restart/reload}"
    exit 1
esac
